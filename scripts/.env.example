# 复制本文件为 .env 并填入你的凭据（不要提交 .env）
# 支持任意 OpenAI 兼容的视觉模型平台：
#   阿里云百炼 DashScope: https://dashscope.aliyuncs.com/compatible-mode/v1
#   智谱 GLM:            https://open.bigmodel.cn/api/paas/v4               （glm-4v-plus 等）
#   月之暗面 Moonshot:   https://api.moonshot.cn/v1                         （moonshot-v1-8k-vision-preview 等）
#   OpenAI:              https://api.openai.com/v1                          （gpt-4o / gpt-4.1-mini 等）

# 主供应商：模型支持逗号分隔的优先级列表，主模型失败自动切换下一个
VISION_API_KEY=sk-你的key
VISION_MODEL=qwen3.8-max,qwen3.7-plus,qwen3.7-flash-2026-07-15,qwen-vl-max,qwen-vl-plus
# VISION_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# 备用供应商（ModLens 式 failover）：主供应商全部失败后自动切换
# VISION2_API_KEY=sk-你的备用key
# VISION2_MODEL=glm-4v-plus,qwen-vl-plus
# VISION2_BASE_URL=https://open.bigmodel.cn/api/paas/v4

# 可选 OpenAI 兼容第三供应商（如中转）
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=https://api.openai.com/v1

# 结构化输出（推荐）：node vision.js <图片> --schema img2img | ecom
# 诊断：node vision.js guard | --list-providers
